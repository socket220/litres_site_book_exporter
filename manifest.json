{
  "manifest_version": 2,
  "name": "litres book exporter",
  "version": "0.6.0",
  "description": "__MSG_description__",
  "permissions": [
    "storage",
    "downloads",
    "https://*.litres.ru/*",
    "https://*.litres.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "local-reader-epub@example.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "i18n.js",
      "core.js",
      "epub.js",
      "formats.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "litres book exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.litres.ru/static/reader/text/*"
      ],
      "js": [
        "i18n.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en"
}
